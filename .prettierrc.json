{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "tabWidth": 3,
  "plugins": ["prettier-plugin-astro"],
  "overrides": [
    {
      "files": ["*.json", "*.jsonc", "*.yaml", "*.yml", "*.md"],
      "options": {
        "tabWidth": 2
      }
    },
    {
      "files": "*.jsonc",
      "options": {
        "trailingComma": "none"
      }
    }
  ]
}
