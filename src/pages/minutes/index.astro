---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

const minutes = (
   await getCollection('minutes', ({ data }) => !data.draft)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const baseUrl = import.meta.env.BASE_URL;
---

<SiteLayout
   title="Meeting Minutes"
   description="Meeting minutes from the Hidden Valleys Amateur Radio Club."
>
   {minutes.length > 0 ? (
      <ul>
         {minutes.map((entry) => (
            <li>
               <a href={`${baseUrl}minutes/${entry.id}/`}>{entry.data.title}</a>
               {' — '}
               <time datetime={entry.data.date.toISOString()}>
                  {new Intl.DateTimeFormat('en-US', {
                     dateStyle: 'long',
                     timeZone: 'UTC',
                  }).format(entry.data.date)}
               </time>
            </li>
         ))}
      </ul>
   ) : (
      <p>No meeting minutes have been published yet.</p>
   )}
</SiteLayout>
