---
import SiteLayout from './SiteLayout.astro';

const { frontmatter } = Astro.props;
---

<SiteLayout title={frontmatter.title} description={frontmatter.description}>
   <article class="hamfest-poster">
      <img
         class="banner"
         src={`${import.meta.env.BASE_URL}images/HVARC%20Hamfest%20at%20the%20Fairgrounds.png`}
         alt="HVARC Free Hamfest, Saturday, October 16, 2027, at Grant County Fairgrounds"
         width="1916"
         height="821"
      />
      <slot />
   </article>
</SiteLayout>

<style>
   .hamfest-poster {
      max-width: 816px;
      margin: 0 auto;
      padding: 0 clamp(1.25rem, 6vw, 3.5rem) 2rem;
      overflow-wrap: anywhere;
      background: var(--poster-background);
      color: var(--poster-text);
   }

   .hamfest-poster .banner {
      display: block;
      width: calc(100% + 2 * clamp(1.25rem, 6vw, 3.5rem));
      max-width: none;
      height: auto;
      margin: 0 calc(-1 * clamp(1.25rem, 6vw, 3.5rem));
   }

   .hamfest-poster :global(h2) {
      margin: 1.5rem 0 0;
      color: var(--poster-heading);
      font-size: clamp(1.75rem, 5vw, 2.5rem);
      line-height: 1.2;
   }

   .hamfest-poster :global(h3) {
      margin: 2rem 0 0.5rem;
      color: var(--poster-muted);
      font-size: 0.95rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
   }

   .hamfest-poster :global(h3 + p) {
      margin-top: 0;
      color: var(--poster-heading);
      font-size: 1.2rem;
   }

   .hamfest-poster :global(h4) {
      margin-bottom: 0.5rem;
      color: var(--poster-heading);
      font-size: 1.2rem;
      text-transform: uppercase;
   }

   .hamfest-poster :global(a) {
      color: var(--poster-link);
      font-weight: 700;
   }

   .hamfest-poster :global(img) {
      display: block;
      max-width: 100%;
      height: auto;
   }
</style>
