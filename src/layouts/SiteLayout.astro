---
const page = Astro.props.frontmatter ?? Astro.props;
const pageTitle = page.title ?? 'Hidden Valleys Amateur Radio Club';
const pageDescription =
   page.description ??
   'The Hidden Valleys Amateur Radio Club meets in Platteville, Wisconsin. Anyone interested in amateur radio is welcome.';
const canonicalUrl = Astro.site
   ? new URL(Astro.url.pathname, Astro.site)
   : undefined;
const sitePath = (path: string) =>
   `${import.meta.env.BASE_URL}${path.slice(1)}`;
const navigation = [
   { label: 'Meetings', href: '/meetings/' },
   { label: 'Events', href: '/events/' },
   // { label: 'Field Day', href: '/fieldday/' },
   // { label: 'Hamfest', href: '/hamfest/' },
   { label: 'Infrastructure', href: '/infrastructure/' },
   { label: 'Links', href: '/links/' },
   { label: 'Club Info', href: '/contact/' },
   { label: 'About', href: '/about/' },
];
---

<!doctype html>
<html lang="en">
   <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width" />
      <meta name="description" content={pageDescription} />
      <meta name="generator" content={Astro.generator} />
      {import.meta.env.BASE_URL !== '/' && (
         <meta name="robots" content="noindex" />
      )}
      <title>{pageTitle === 'Home' ? 'HVARC' : `${pageTitle} | HVARC`}</title>
      {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
      <meta property="og:type" content="website" />
      <meta property="og:title" content={pageTitle} />
      <meta property="og:description" content={pageDescription} />
      {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
      <link
         rel="icon"
         type="image/png"
         href={sitePath('/assets/favicon.png')}
      />
   </head>
   <body class={page.title === 'Home' ? 'home-page' : undefined}>
      <header class="site-header">
         <a
            class="brand"
            href={sitePath('/')}
            aria-label="Hidden Valleys Amateur Radio Club home"
         >
            <img
               src={sitePath('/assets/hvarc_image32.png')}
               alt=""
               width="37"
               height="37"
            />
            <span>Hidden Valleys Amateur Radio Club</span>
         </a>
         <nav aria-label="Main navigation">
            <ul>
               {navigation.map((item) => (
                  <li>
                     <a
                        href={sitePath(item.href)}
                        aria-current={
                           Astro.url.pathname === sitePath(item.href)
                              ? 'page'
                              : undefined
                        }
                     >
                        {item.label}
                     </a>
                  </li>
               ))}
            </ul>
         </nav>
      </header>
      <main class="content">
         <h1>{pageTitle}</h1>
         <slot />
      </main>
      <footer class="site-footer">
         <p>
            &copy; {new Date().getFullYear()} Hidden Valleys Amateur Radio Club
         </p>
         <p>{pageDescription}</p>
      </footer>
   </body>
</html>

<style>
   :global(*) {
      box-sizing: border-box;
   }

   :global(body) {
      margin: 0;
      color: #242424;
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.6;
   }

   .site-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1rem 2rem;
      padding: 1rem max(1.25rem, calc((100% - 72rem) / 2));
      border-bottom: 1px solid #d6d6d6;
   }

   .brand {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      color: #173c58;
      font-size: 1.15rem;
      font-weight: 700;
      text-decoration: none;
   }

   .brand img {
      flex: none;
      object-fit: contain;
   }

   nav ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1rem;
      margin: 0;
      padding: 0;
      list-style: none;
   }

   nav a {
      color: #173c58;
      text-decoration: none;
   }

   nav a:hover,
   nav a[aria-current='page'] {
      text-decoration: underline;
      text-underline-offset: 0.2em;
   }

   .content {
      width: min(100% - 2.5rem, 72rem);
      min-height: 60vh;
      margin: 2rem auto 3rem;
   }

   .content :global(img) {
      max-width: 100%;
      height: auto;
   }

   :global(.home-page .content > img:first-of-type) {
      float: right;
      max-width: 120px;
      margin: 0 0 1.5rem 1.5rem;
   }

   .site-footer {
      padding: 1.5rem max(1.25rem, calc((100% - 72rem) / 2));
      border-top: 1px solid #d6d6d6;
      background: #f5f5f5;
      color: #444;
   }

   .site-footer p {
      margin: 0.25rem 0;
   }

   :global(a:focus-visible) {
      outline: 3px solid #b24800;
      outline-offset: 3px;
   }

   @media (max-width: 48rem) {
      .site-header {
         align-items: flex-start;
      }

      nav ul {
         gap: 0.5rem 0.9rem;
      }

      :global(.home-page .content > img:first-of-type) {
         float: none;
         display: block;
         margin: 0 auto 1.5rem;
      }
   }
</style>
