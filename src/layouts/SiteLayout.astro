---
import '../styles/global.css';

const page = Astro.props.frontmatter ?? Astro.props;
const pageTitle = page.title ?? 'Hidden Valleys Amateur Radio Club';
const pageDescription =
   page.description ??
   'The Hidden Valleys Amateur Radio Club meets in Platteville, Wisconsin. Anyone interested in amateur radio is welcome.';
const canonicalUrl = Astro.site
   ? new URL(Astro.url.pathname, Astro.site)
   : undefined;
const sitePath = (path: string) =>
   `${import.meta.env.BASE_URL}${path.slice(1)}`;
const navigation = [
   { label: 'Meetings', href: '/meetings/' },
   { label: 'Minutes', href: '/minutes/' },
   { label: 'Events', href: '/events/' },
   // { label: 'Field Day', href: '/fieldday/' },
   // { label: 'Hamfest', href: '/hamfest/' },
   { label: 'Amateur Radio', href: '/amateur-radio/' },
   { label: 'Mesh', href: '/mesh/' },
   { label: 'Links', href: '/links/' },
   { label: 'Club Info', href: '/contact/' },
   { label: 'About', href: '/about/' },
];
---

<!doctype html>
<html lang="en">
   <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width" />
      <meta name="description" content={pageDescription} />
      <meta name="generator" content={Astro.generator} />
      {import.meta.env.BASE_URL !== '/' && (
         <meta name="robots" content="noindex" />
      )}
      <title>{pageTitle === 'Home' ? 'HVARC' : `${pageTitle} | HVARC`}</title>
      {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
      <meta property="og:type" content="website" />
      <meta property="og:title" content={pageTitle} />
      <meta property="og:description" content={pageDescription} />
      {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
      <link
         rel="icon"
         type="image/png"
         href={sitePath('/assets/favicon.png')}
      />
      <script is:inline>
         const savedTheme = localStorage.getItem('hvarc-theme');
         const preferredTheme = window.matchMedia(
            '(prefers-color-scheme: dark)',
         ).matches
            ? 'dark'
            : 'light';
         document.documentElement.dataset.theme =
            savedTheme === 'dark' || savedTheme === 'light'
               ? savedTheme
               : preferredTheme;
      </script>
   </head>
   <body class={page.title === 'Home' ? 'home-page' : undefined}>
      <header class="site-header">
         <a
            class="brand"
            href={sitePath('/')}
            aria-label="Hidden Valleys Amateur Radio Club home"
         >
            <picture class="brand-logo">
               <img
                  class="brand-logo-light"
                  src={sitePath(
                     '/images/KC9KQ Hidden Valleys Radio Club Logo light.png',
                  )}
                  alt=""
                  width="37"
                  height="37"
               />
               <img
                  class="brand-logo-dark"
                  src={sitePath(
                     '/images/KC9KQ Hidden Valleys Radio Club Logo dark.png',
                  )}
                  alt=""
                  width="37"
                  height="37"
               />
            </picture>
            <span>Hidden Valleys Amateur Radio Club</span>
         </a>
         <nav aria-label="Main navigation">
            <ul>
               {navigation.map((item) => (
                  <li>
                     <a
                        href={sitePath(item.href)}
                        aria-current={
                           Astro.url.pathname === sitePath(item.href)
                              ? 'page'
                              : undefined
                        }
                     >
                        {item.label}
                     </a>
                  </li>
               ))}
            </ul>
         </nav>
         <button
            class="theme-toggle"
            type="button"
            aria-label="Toggle dark mode"
            aria-pressed="false"
         >
            Dark mode
         </button>
      </header>
      <main class="content">
         <h1 class={page.title === 'Home' ? 'visually-hidden' : undefined}>
            {pageTitle}
         </h1>
         <slot />
      </main>
      <footer class="site-footer">
         <div class="footer-content">
            <p class="footer-copyright">
               &copy; {new Date().getFullYear()} Hidden Valleys
               <br />
               Amateur Radio Club
            </p>
            <nav class="footer-social" aria-label="Social links">
               <a
                  href="https://www.facebook.com/HVARC"
                  target="_blank"
                  rel="noopener noreferrer"
               >
                  <svg
                     aria-hidden="true"
                     viewBox="0 0 24 24"
                     width="20"
                     height="20"
                  >
                     <path
                        fill="currentColor"
                        d="M14.4 8.1V6.2c0-.9.6-1.1 1-1.1h2.6V1h-3.6C10.2 1 9.4 4.1 9.4 6v2.1H7v4.1h2.4V23h5V12.2h3.4l.5-4.1H14.4Z"
                     />
                  </svg>
                  <span>HVARC</span>
               </a>
               <a
                  href="https://github.com/kc9kq"
                  target="_blank"
                  rel="noopener noreferrer"
               >
                  <svg
                     aria-hidden="true"
                     viewBox="0 0 24 24"
                     width="20"
                     height="20"
                  >
                     <path
                        fill="currentColor"
                        d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.02c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.38.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.72 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.16 1.19a10.94 10.94 0 0 1 5.76 0c2.2-1.5 3.16-1.19 3.16-1.19.63 1.59.23 2.77.11 3.06.74.81 1.18 1.84 1.18 3.1 0 4.45-2.71 5.42-5.29 5.71.42.36.79 1.08.79 2.18v3.23c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"
                     />
                  </svg>
                  <span>kc9kq</span>
               </a>
            </nav>
            <p class="footer-description">{pageDescription}</p>
         </div>
      </footer>
      <script is:inline>
         const labelResponsiveTableCells = () => {
            const content = document.querySelector('.content');
            content?.querySelectorAll('table').forEach((table) => {
               const headers = Array.from(table.querySelectorAll('thead th'));

               table.querySelectorAll('tbody tr').forEach((row) => {
                  Array.from(row.cells).forEach((cell, index) => {
                     const label = headers[index]?.textContent?.trim();
                     if (label) {
                        cell.setAttribute('data-label', label);
                     }
                  });
               });
            });
         };

         labelResponsiveTableCells();

         const themeToggle = document.querySelector('.theme-toggle');
         const setTheme = (theme, persist = false) => {
            document.documentElement.dataset.theme = theme;
            themeToggle.setAttribute('aria-pressed', String(theme === 'dark'));
            if (persist) {
               localStorage.setItem('hvarc-theme', theme);
            }
         };

         setTheme(document.documentElement.dataset.theme);
         themeToggle.addEventListener('click', () => {
            setTheme(
               document.documentElement.dataset.theme === 'dark'
                  ? 'light'
                  : 'dark',
               true,
            );
         });

         const content = document.querySelector('.content');
         if (content) {
            new MutationObserver(labelResponsiveTableCells).observe(content, {
               childList: true,
               subtree: true,
            });
         }
      </script>
   </body>
</html>

<style>
   .site-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1rem 2rem;
      padding: 1rem max(1.25rem, calc((100% - 72rem) / 2));
      border-bottom: 1px solid var(--border-color);
   }

   .brand {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      color: var(--link-color);
      font-size: 1.15rem;
      font-weight: 700;
      text-decoration: none;
   }

   .brand img {
      flex: none;
      width: 37px;
      height: 37px;
      object-fit: contain;
   }

   .brand-logo {
      display: contents;
   }

   :global(:root[data-theme='light']) .brand-logo-dark,
   :global(:root[data-theme='dark']) .brand-logo-light {
      display: none;
   }

   :global(:root[data-theme='light'] .theme-logo-dark),
   :global(:root[data-theme='dark'] .theme-logo-light) {
      display: none;
   }

   nav ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1rem;
      margin: 0;
      padding: 0;
      list-style: none;
   }

   nav a {
      color: var(--link-color);
      text-decoration: none;
   }

   nav a:hover,
   nav a[aria-current='page'] {
      text-decoration: underline;
      text-underline-offset: 0.2em;
   }

   .theme-toggle {
      padding: 0.45rem 0.7rem;
      border: 1px solid var(--border-color);
      border-radius: 0.35rem;
      background: var(--surface-background);
      color: var(--page-text);
      font: inherit;
      cursor: pointer;
   }

   .theme-toggle:hover {
      border-color: var(--link-color);
   }

   .content {
      width: min(100% - 2.5rem, 72rem);
      min-height: 60vh;
      margin: 2rem auto 3rem;
   }

   .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
   }

   .content :global(.repeater-image) {
      float: right;
      margin: 5px;
   }

   .content :global(.qso-party-image) {
      float: right;
      margin: 5px;
   }

   :global(.home-page .content > .theme-logo) {
      float: right;
      display: block;
      max-width: 360px;
      margin: 0 0 1.5rem 1.5rem;
   }

   :global(.home-page .content > .theme-logo img) {
      width: 100%;
      height: auto;
   }

   .site-footer {
      clear: both;
      padding: 1.5rem max(1.25rem, calc((100% - 72rem) / 2));
      border-top: 1px solid var(--border-color);
      background: var(--surface-background);
      color: var(--surface-text);
   }

   .footer-content {
      display: grid;
      grid-template-columns: 1fr 12rem minmax(0, 1.15fr);
      align-items: start;
      gap: 2rem;
   }

   .footer-content p {
      margin: 0;
   }

   .footer-copyright {
      line-height: 1.6;
   }

   .footer-social {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
   }

   .footer-social a {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      color: var(--link-accent);
      text-decoration: none;
   }

   .footer-social a:hover {
      text-decoration: underline;
      text-underline-offset: 0.2em;
   }

   .footer-description {
      line-height: 1.6;
   }

   :global(a:focus-visible),
   .theme-toggle:focus-visible {
      outline: 3px solid var(--focus-color);
      outline-offset: 3px;
   }

   @media (max-width: 48rem) {
      .site-header {
         align-items: flex-start;
      }

      .theme-toggle {
         margin-left: auto;
      }

      nav ul {
         gap: 0.5rem 0.9rem;
      }

      :global(.home-page .content > .theme-logo) {
         float: none;
         display: block;
         margin: 0 auto 1.5rem;
      }

      .content :global(.repeater-image) {
         float: none;
         display: block;
         margin: 0 auto 1.5rem;
      }

      .content :global(.qso-party-image) {
         float: none;
         display: block;
         margin: 0 auto 1.5rem;
      }

      .footer-content {
         grid-template-columns: 1fr;
         gap: 0.75rem;
      }

      .footer-social {
         flex-direction: row;
         flex-wrap: wrap;
         gap: 0.25rem 1.25rem;
      }
   }

   @media (max-width: 30rem) {
      .brand {
         font-size: clamp(0.6875rem, 3.8vw, 0.875rem);
      }

      .brand span {
         white-space: nowrap;
      }
   }
</style>
